# MiniMax Coding Plan key (sk-cp-...) — от друга или platform.minimax.io
MINIMAX_CODE_PLAN_KEY=your_sk_cp_key_here
# Portal provider использует этот alias (можно оставить тем же значением)
MINIMAX_OAUTH_TOKEN=your_sk_cp_key_here

# Обычный API key (sk-api-...) — только если НЕ Coding Plan
# MINIMAX_API_KEY=your_minimax_api_key_here

# International: https://api.minimax.io | Domestic: https://api.minimaxi.com
MINIMAX_BASE_URL=https://api.minimax.io/anthropic
MINIMAX_MODEL=MiniMax-M3

# OpenRouter (альтернатива / fallback)
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/openai/gpt-oss-20b:free

# OpenClaw Gateway
OPENCLAW_GATEWAY_PORT=18789

# Image generation uses MiniMax image-01 (same key) or OpenRouter image models
# OPENROUTER_API_KEY already enables openrouter/google/gemini-3.1-flash-image-preview

# VK community bot token (https://vk.com/groups?act=manage → API → Keys)
# Setup: .\scripts\setup-vk-channel.ps1 — see docs/VK-CHANNEL-SETUP.md
VK_GROUP_TOKEN=your_vk_group_token_here

# Optional: GigaChat (альтернативный LLM для Python runtime Phase 2)
# GIGACHAT_CLIENT_ID=your_client_id_here
# GIGACHAT_CLIENT_SECRET=your_client_secret_here
# GIGACHAT_MODEL=GigaChat

# Optional: Database (Phase 2 FastAPI runtime)
# DATABASE_URL=postgresql://eventgenie:eventgenie_pass@localhost:5433/eventgenie

# Optional: API (Phase 2)
# API_HOST=0.0.0.0
# API_PORT=8001
